---
interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<a
  href={href}
  class="flex items-center dark:bg-blue-950 dark:hover:bg-blue-900 dark:border-blue-800 hover:bg-gray-100 border-gray-300 border-[1px] transition-all duration-200 py-1 px-3 rounded-md"
>
  <div class="mr-2">
    <slot name="icon" />
  </div>

  <span class="ml-2">{label}</span>
</a>
