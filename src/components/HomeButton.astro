---
import { Icon } from 'astro-icon/components';

interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<a href={href} class='group flex items-center transition-all py-2 md:py-0'>
  <span class='mr-4 group-hover:translate-x-1.5 transition-all'>
    <Icon
      name='arrow'
      width={12}
      height={12}
      class='dark:text-white text-black'
    />
  </span>

  <span
    class='text-lg text-blue-500 dark:text-blue-300 dark:group-hover:text-blue-400 group-hover:underline'
  >
    {label}
  </span>
</a>
