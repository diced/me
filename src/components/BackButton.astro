---
import { Icon } from 'astro-icon/components';
const isHome = Astro.url.pathname === '/';
---

{
  !isHome && (
    <div class='z-[9999] fixed top-0 left-0 flex items-center justify-center w-16 h-16'>
      <a
        aria-label='go back to home'
        href='/'
        class='dark:text-white p-2 md:p-1 bg-white dark:bg-blue-950 dark:border-blue-800 border-gray-300 border-[1px] rounded-md hover:bg-gray-100 dark:hover:bg-blue-900 transition duration-200'
      >
        <Icon name='tabler:arrow-back-up' width={24} height={24} />
      </a>
    </div>
  )
}
