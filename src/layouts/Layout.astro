---
import BackButton from "../components/BackButton.astro";
import ThemeButton from "../components/ThemeButton.astro";
import { blurZoom } from "../lib/blur-zoom";
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <ClientRouter />

    <script
      async
      is:inline
      data-astro-rerun
      src="https://analytics_.diced.sh/script.js"
      data-website-id="1a4199c1-e18c-4d22-91f4-a6e41fef4dfa"></script>

    <Font cssVariable="--font-jetbrains-mono" preload />
  </head>
  <body
    class="dark:bg-blue-950"
    transition:animate={blurZoom({
      duration: "300ms",
      easingIn: "cubic-bezier(0.6, -0.28, 0.735, 0.045)",
      easingOut: "cubic-bezier(0.175, 0.885, 0.32, 1.275)",
    })}
  >
    <BackButton />
    <ThemeButton />

    <slot />

    <script is:inline>
      function getTheme() {
        if (
          typeof localStorage !== "undefined" &&
          localStorage.getItem("theme")
        ) {
          return localStorage.getItem("theme");
        }
        if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
          return "dark";
        }
        return "light";
      }

      function updateTheme(theme) {
        if (theme === "light") {
          document.documentElement.classList.remove("dark");
        } else {
          document.documentElement.classList.add("dark");
        }
      }

      window
        .matchMedia("(prefers-color-scheme: dark)")
        .addEventListener("change", (e) => {
          updateTheme(e.matches ? "dark" : "light");
        });

      document.addEventListener("astro:after-swap", () => {
        updateTheme(getTheme());
      });

      updateTheme(getTheme());
    </script>

    <style is:global>
      html {
        font-family: var(--font-jetbrains-mono), monospace;
      }

      html.dark {
        color-scheme: dark;
      }

      @keyframes blur-shrink-out {
        0% {
          filter: blur(0px);
          transform: scale(1);
          opacity: 1;
        }
        40% {
          filter: blur(30px);
          transform: scale(1.1);
          opacity: 0.8;
        }
        100% {
          filter: blur(50px);
          transform: scale(0);
          opacity: 0;
        }
      }

      @keyframes blur-shrink-in {
        0% {
          filter: blur(50px);
          transform: scale(0);
          opacity: 0;
        }
        60% {
          filter: blur(30px);
          transform: scale(1.1);
          opacity: 1;
        }
        100% {
          filter: blur(0px);
          transform: scale(1);
          opacity: 1;
        }
      }
    </style>
  </body>
</html>
