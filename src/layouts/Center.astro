---
import type { AstroSeoProps } from '@astrolib/seo';
import Layout from './Layout.astro';

interface Props {
  class?: string;
  metadata?: AstroSeoProps;
}

const { class: className, metadata } = Astro.props;
---

<Layout metadata={metadata}>
  <main
    class:list={[
      className,
      'flex',
      'items-center',
      'justify-center',
      'dark:text-white',
    ]}
  >
    <slot />
  </main>
</Layout>
