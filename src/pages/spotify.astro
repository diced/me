---
import Center from '../layouts/Center.astro';
import SpotifyComponent from '../components/Spotify.tsx';

const metadata = {
  title: 'spotify',
  description: 'spotify',
};
---

<Center metadata={metadata}>
  <div class='my-24'>
    <p class='text-4xl font-bold mb-10'>spotify</p>

    <SpotifyComponent transition:persist client:load />
  </div>
</Center>
