---
import TagContainer from '../components/about/TagContainer.astro';
import Header from '../components/about/Header.astro';
import Link from '../components/Link.astro';
import Center from '../layouts/Center.astro';

const tech: string[] = [
  'Linux',
  'Arch Linux',
  'NixOS',
  'WSL',

  'React',
  'Next.js',
  'Astro',

  'Tailwind CSS',

  'Node.js',

  'PostgreSQL',
  'SQLite',
  'Redis',

  'Docker',

  'pnpm',

  'VSCode',

  'git',
];

const languages: string[] = [
  'TypeScript',
  'JavaScript',
  'Python',
  'Java',
  'Typst',
];

const metadata = {
  title: 'about',
  description: 'about me',
};
---

<Center metadata={metadata}>
  <div class='my-24 mx-8 md:mx-[36rem]'>
    <p class='text-4xl font-bold mb-4'>about</p>

    <p>Hello, I create some useful things sometimes.</p>

    <p class='mt-8 font-bold'>things I do:</p>
    <ul class='list-image-arrow'>
      <li>programming</li>
      <li>gaming</li>
      <li>watch shows</li>
      <li>scroll</li>
    </ul>

    <Header>stuff I use:</Header>
    <TagContainer tags={tech} />

    <Header>languages I use:</Header>
    <TagContainer tags={languages} />

    <Header>useful links:</Header>
    <ul class='list-image-arrow'>
      <li>
        <Link href='/go/github'>GitHub</Link>
      </li>
      <li>
        <Link href='/go/zipline'>Zipline</Link>
      </li>
    </ul>
  </div>
</Center>
